# Labelled photos for cat.jud: twelve domestic cats, seven dogs (the hard
# negatives), one fish and six scenes with no animal. Each case names its
# image once, in `assets`, by a path relative to this file; the reference
# is what the state carries. Sources and licences: images/SOURCES.md.
#
#   jud check cat.jud cat-cases.jud
#   jud record --out recordings cat.jud cat-cases.jud    # asks the server once per case
#   jud eval --replay recordings cat.jud cat-cases.jud   # grades, no server
#   jud tune --replay recordings cat.jud cat-cases.jud   # proposes the bars
apiVersion: jud/v1
kind: Cases
metadata:
  name: cat-picture-cases
  minor: 4
  description: Twenty-six photos labelled with whether a cat is in them and what the main subject is.
spec:
  rubric: cat-picture
  cases:
    - id: persian-98
      state: {photo: persian-98}
      assets:
        persian-98: {type: image, path: images/persian-98.jpg}
      expect: {cat_present: true, subject: cat}
      tags: [cat]
    - id: sphynx-59
      state: {photo: sphynx-59}
      assets:
        sphynx-59: {type: image, path: images/sphynx-59.jpg}
      expect: {cat_present: true, subject: cat}
      tags: [cat]
    - id: abyssinian-57
      state: {photo: abyssinian-57}
      assets:
        abyssinian-57: {type: image, path: images/abyssinian-57.jpg}
      expect: {cat_present: true, subject: cat}
      tags: [cat]
    - id: british-shorthair-269
