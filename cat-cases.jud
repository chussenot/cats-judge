        british-shorthair-89: {type: image, path: images/british-shorthair-89.jpg}
      expect: {cat_present: true, subject: cat}
      tags: [cat]
    - id: birman-62
      state: {photo: birman-62}
      assets:
        birman-62: {type: image, path: images/birman-62.jpg}
      expect: {cat_present: true, subject: cat}
      tags: [cat]
    - id: ragdoll-45
      state: {photo: ragdoll-45}
      assets:
        ragdoll-45: {type: image, path: images/ragdoll-45.jpg}
      expect: {cat_present: true, subject: cat}
      tags: [cat]
    - id: british-shorthair-70
      state: {photo: british-shorthair-70}
      assets:
        british-shorthair-70: {type: image, path: images/british-shorthair-70.jpg}
      expect: {cat_present: true, subject: cat}
      tags: [cat]
    - id: persian-265
      state: {photo: persian-265}
      assets:
